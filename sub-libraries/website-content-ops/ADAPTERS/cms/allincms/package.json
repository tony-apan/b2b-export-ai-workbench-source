  "scripts": {
    "test": "node --test upload-media-browser.test.mjs article-image-binding.test.mjs article-content-formats.test.mjs article-operations.test.mjs workspace-preflight.test.mjs content-run-controller.test.mjs interface-registry.test.mjs",
    "test:media": "node --test upload-media-browser.test.mjs",
    "test:article-images": "node --test article-image-binding.test.mjs",
    "test:articles": "node --test article-content-formats.test.mjs article-operations.test.mjs article-image-binding.test.mjs",
    "test:all": "node --test upload-media-browser.test.mjs article-image-binding.test.mjs article-content-formats.test.mjs article-operations.test.mjs workspace-preflight.test.mjs content-run-controller.test.mjs interface-registry.test.mjs",
